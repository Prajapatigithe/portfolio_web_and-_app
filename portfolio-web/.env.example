# Browser-safe Supabase publishable key only. Never put a secret/service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set the real public origin (https://your-domain.com) before production build.
VITE_SITE_URL=
# Optional Google Analytics measurement ID. Leave blank to disable.
VITE_GA_MEASUREMENT_ID=
